@page "/logout"

@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Navigation

@code {
    private bool _isRedirecting = false;

    protected override async Task OnInitializedAsync()
    {
        var context = HttpContextAccessor.HttpContext;

        if (context != null)
        {
            await context.SignOutAsync(CookieAuthenticationDefaults.AuthenticationScheme);
        }

        _isRedirecting = true;
        StateHasChanged();  // Force un re-render pour effectuer la redirection après le cycle de rendu
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (_isRedirecting && firstRender)
        {
            Navigation.NavigateTo("/login", true);  // Force un rechargement complet
        }
    }
}
@page "/postePage"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Authorization
@using PR3_Blazor_Mud.Components.Models
@using PR3_Blazor_Mud.Components.Services
@using MudBlazor
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject CommandeService CommandeService
@inject PosteService PosteService
@inject SalleService SalleService
@inject ISnackbar Snackbar

@rendermode InteractiveServer

<MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
    <MudText Typo="Typo.h4" GutterBottom="true">Gestion des postes</MudText>
    <MudText Typo="Typo.body1" Class="mb-4">Consultez, modifiez et supprimez les postes</MudText>

    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-4">
        Pour l'ajout de postes, utiliser l'application Desktop.
    </MudAlert>

    <MudPaper Class="pa-4" Elevation="1">
        @if (posteList == null)
        {
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Class="mt-2">Chargement des postes...</MudText>
        }
        else
        {
            @if (IsAdmin)
            {
                <MudButton Color="Color.Secondary"
                           Variant="Variant.Filled"
                           Class="mb-4"
                           StartIcon="@Icons.Material.Filled.Sync"
                           OnClick="RefreshAllPostes">
                    Actualiser tous les postes
                </MudButton>
            }
            <MudGrid Class="mb-4">

    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4 rounded-lg" Elevation="3">
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">
                Total postes
            </MudText>
            <MudText Typo="Typo.h4" Class="fw-bold">
                @TotalPostes
            </MudText>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4 rounded-lg" Elevation="3">
            <MudText Typo="Typo.subtitle2" Color="Color.Success">
                Postes connectés
            </MudText>
            <MudText Typo="Typo.h4" Class="fw-bold">
                @PostesConnectes
            </MudText>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4 rounded-lg" Elevation="3">
            <MudText Typo="Typo.subtitle2" Color="Color.Error">
                Postes déconnectés
            </MudText>
            <MudText Typo="Typo.h4" Class="fw-bold">
                @PostesDeconnectes
            </MudText>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4 rounded-lg" Elevation="3">
            <MudText Typo="Typo.subtitle2" Color="Color.Warning">
                Jamais remontés
            </MudText>
            <MudText Typo="Typo.h4" Class="fw-bold">
                @PostesJamaisRemontes
            </MudText>
        </MudPaper>
    </MudItem>

</MudGrid>

<MudPaper Class="pa-4 mb-4 rounded-lg" Elevation="2">
    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">
        Dernière remontée détectée
    </MudText>

    <MudText Typo="Typo.h6">
        @DerniereRemonteeTexte
    </MudText>
</MudPaper>
            <MudTable Items="posteList" Hover="true" Striped="true" Dense="false">
                <HeaderContent>
              
    <MudTh>ID</MudTh>
    <MudTh>Numéro</MudTh>
    <MudTh>Adresse MAC</MudTh>
    <MudTh>État</MudTh>
    <MudTh>Salle</MudTh>
    <MudTh>Établissement</MudTh>
    <MudTh>Nom machine</MudTh>
    <MudTh>IP</MudTh>
    <MudTh>OS</MudTh>
    <MudTh>RAM</MudTh>
    <MudTh>Disque</MudTh>
    <MudTh>Dernière remontée</MudTh>
    <MudTh>Actions</MudTh>

                </HeaderContent>

                <RowTemplate>
                    <MudTd DataLabel="ID">@context.Id</MudTd>

                    <MudTd DataLabel="Numéro">@context.Numero</MudTd>

                    <MudTd DataLabel="Adresse MAC">@context.MacAdress</MudTd>

                    <MudTd DataLabel="État">
                        @if (IsOnline(context))
                        {
                            <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small">
                                Connecté
                            </MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Color="Color.Error" Variant="Variant.Filled" Size="Size.Small">
                                Déconnecté
                            </MudChip>
                        }
                    </MudTd>

                    <MudTd DataLabel="Salle">
                        @(context.SalleNom ?? GetNomSalle(context.SalleId))
                    </MudTd>

                    <MudTd DataLabel="Établissement">
                        @(context.EtablissementNom ?? "-")
                    </MudTd>

                    <MudTd DataLabel="Nom machine">
                        @(context.NomMachine ?? "-")
                    </MudTd>

                    <MudTd DataLabel="IP">
                        @(context.AdresseIP ?? "-")
                    </MudTd>

                    <MudTd DataLabel="OS">
                        @(context.OsVersion ?? "-")
                    </MudTd>

                    <MudTd DataLabel="RAM">
                        @FormatRam(context)
                    </MudTd>

                    <MudTd DataLabel="Disque">
                        @FormatDisk(context)
                    </MudTd>

                    <MudTd DataLabel="Dernière remontée">
                        @(context.LastSeen?.ToString("dd/MM/yyyy HH:mm:ss") ?? "-")
                    </MudTd>

                    <MudTd DataLabel="Actions">
                        @if (IsAdmin)
                        {
                            <MudButton Color="Color.Secondary"
                                       Variant="Variant.Outlined"
                                       Size="Size.Small"
                                       Class="mr-2"
                                       OnClick="@(() => RefreshSelectedPoste(context.Id))">
                                Actualiser
                            </MudButton>
                        }

                        @if (CanEdit)
                        {
                            <MudButton Color="Color.Primary"
                                       Variant="Variant.Outlined"
                                       Size="Size.Small"
                                       Class="mr-2"
                                       OnClick="@(() => OpenUpdateDialog(context.Id))">
                                Modifier
                            </MudButton>
                        }

                        @if (IsAdmin)
                        {
                            <MudButton Color="Color.Error"
                                       Variant="Variant.Outlined"
                                       Size="Size.Small"
                                       OnClick="@(() => DeletePoste(context.Id))">
                                Supprimer
                            </MudButton>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>
</MudContainer>
<MudPaper Class="pa-4 mt-6" Elevation="1">
    <MudText Typo="Typo.h5" GutterBottom="true">
        Historique des opérations administrateur
    </MudText>

    <MudText Typo="Typo.body2" Class="mb-4">
        Cette section permet de suivre les commandes envoyées aux postes et leur état d’exécution.
    </MudText>
    <MudButton Color="Color.Primary"
               Variant="Variant.Outlined"
               Class="mb-4"
               StartIcon="@Icons.Material.Filled.Refresh"
               OnClick="FetchCommandeList">
        Recharger l'historique
    </MudButton>
    @if (commandeList == null)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        <MudText Class="mt-2">Chargement de l'historique...</MudText>
    }
    else if (!commandeList.Any())
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
            Aucune commande n'a encore été envoyée.
        </MudAlert>
    }
    else
    {
        <MudTable Items="@commandeList"
                  Hover="true"
                  Striped="true"
                  Dense="true"
                  HorizontalScrollbar="true"
                  Breakpoint="Breakpoint.None"
                  Class="commandes-table">

            <HeaderContent>
                <MudTh>ID</MudTh>
                <MudTh>Poste ID</MudTh>
                <MudTh>MAC</MudTh>
                <MudTh>Type</MudTh>
                <MudTh>Portée</MudTh>
                <MudTh>Statut</MudTh>
                <MudTh>Date création</MudTh>
                <MudTh>Date exécution</MudTh>
                <MudTh>Résultat</MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd DataLabel="ID">@context.Id</MudTd>

                <MudTd DataLabel="Poste ID">
                    @(context.PosteId?.ToString() ?? "-")
                </MudTd>

                <MudTd DataLabel="MAC">@context.MacAdress</MudTd>

                <MudTd DataLabel="Type">@context.TypeCommande</MudTd>

                <MudTd DataLabel="Portée">
                    @if (context.Portee == "Global")
                    {
                        <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Filled">
                            Global
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Secondary" Size="Size.Small" Variant="Variant.Filled">
                            Poste
                        </MudChip>
                    }
                </MudTd>

                <MudTd DataLabel="Statut">
                    @if (context.Statut == "Done")
                    {
                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">
                            Terminé
                        </MudChip>
                    }
                    else if (context.Statut == "Pending")
                    {
                        <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled">
                            En attente
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled">
                            Échec
                        </MudChip>
                    }
                </MudTd>

                <MudTd DataLabel="Date création">
                    @context.DateCreation.ToString("dd/MM/yyyy HH:mm:ss")
                </MudTd>

                <MudTd DataLabel="Date exécution">
                    @(context.DateExecution?.ToString("dd/MM/yyyy HH:mm:ss") ?? "-")
                </MudTd>

                <MudTd DataLabel="Résultat">
                    @(string.IsNullOrWhiteSpace(context.Resultat) ? "-" : context.Resultat)
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>
<MudDialog @bind-Visible="IsOpen">
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-4">Modifier un poste</MudText>

        <MudTextField Label="Numéro"
                      @bind-Value="poste.Numero"
                      Required="true"
                      Immediate="true" />

        <MudTextField Label="Adresse MAC"
                      @bind-Value="poste.MacAdress"
                      Disabled="true"
                      Class="mt-3" />

        <MudSelect T="int"
                   Label="Salle"
                   @bind-Value="poste.SalleId"
                   Required="true"
                   Class="mt-3">
            @if (salleList != null)
            {
                @foreach (var salle in salleList)
                {
                    <MudSelectItem Value="@salle.Id">@salle.Numero</MudSelectItem>
                }
            }
        </MudSelect>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="CloseUpdateModal">Annuler</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="UpdatePoste">Enregistrer</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private string? CurrentRole;
    private bool IsAdmin => CurrentRole == "admin";
    private bool CanEdit => CurrentRole == "admin" || CurrentRole == "user" || CurrentRole == "etudiant";
    List<CommandePoste>? commandeList;
    
    List<Poste>? posteList;
    List<Salle>? salleList;
    Poste poste = new Poste();

    public bool IsOpen { get; set; }

    private async Task FetchCommandeList()
    {
        try
        {
            commandeList = await CommandeService.GetCommandes();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Erreur lors du chargement de l'historique : " + ex.Message, Severity.Error);
        }
    }
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        CurrentRole = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;

        await FetchPosteList();
        await FetchCommandeList();
    }
    private async Task FetchPosteList()
    {
        try
        {
            posteList = await PosteService.GetAllPoste();
            salleList = await SalleService.GetAllSalle();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
    private bool IsOnline(Poste p)
    {
        return p.LastSeen.HasValue &&
               p.LastSeen.Value >= DateTime.Now.AddMinutes(-3);
    }

    private string FormatRam(Poste p)
    {
        if (p.RamDisponibleMb.HasValue && p.RamTotaleMb.HasValue)
        {
            return $"{p.RamDisponibleMb.Value:F0} / {p.RamTotaleMb.Value:F0} MB";
        }

        return "-";
    }

    private string FormatDisk(Poste p)
    {
        if (p.DisqueLibreGb.HasValue && p.DisqueTotalGb.HasValue)
        {
            return $"{p.DisqueLibreGb.Value:F1} / {p.DisqueTotalGb.Value:F1} GB";
        }

        return "-";
    }

    private async Task RefreshSelectedPoste(int posteId)
    {
        if (!IsAdmin)
        {
            Snackbar.Add("Seul l'administrateur peut lancer cette opération.", Severity.Warning);
            return;
        }

        try
        {
            await CommandeService.RefreshOnePoste(posteId);
            Snackbar.Add("Commande envoyée au poste sélectionné.", Severity.Success);
            await FetchCommandeList();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Erreur : " + ex.Message, Severity.Error);
        }
    }

    private async Task RefreshAllPostes()
    {
        if (!IsAdmin)
        {
            Snackbar.Add("Seul l'administrateur peut lancer cette opération.", Severity.Warning);
            return;
        }

        try
        {
            await CommandeService.RefreshAllPostes();
            Snackbar.Add("Commande globale envoyée à tous les postes.", Severity.Success);
            await FetchCommandeList();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Erreur : " + ex.Message, Severity.Error);
        }
    }
    private async Task UpdatePoste()
    {
        if (string.IsNullOrWhiteSpace(poste.Numero))
        {
            Snackbar.Add("Le numéro du poste est obligatoire.", Severity.Warning);
            return;
        }

        if (poste.SalleId <= 0)
        {
            Snackbar.Add("Veuillez sélectionner une salle.", Severity.Warning);
            return;
        }

        if (!CanEdit)
        {
            Snackbar.Add("Vous n'avez pas le droit de modifier.", Severity.Warning);
            return;
        }
        try
        {
            await PosteService.UpdatePoste(poste);
            posteList = await PosteService.GetAllPoste();
            CloseUpdateModal();
            Snackbar.Add("Poste modifié avec succès.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
    private int TotalPostes => posteList?.Count ?? 0;

    private int PostesConnectes => posteList?.Count(p => IsOnline(p)) ?? 0;

    private int PostesDeconnectes => posteList?.Count(p => !IsOnline(p)) ?? 0;

    private int PostesJamaisRemontes => posteList?.Count(p => !p.LastSeen.HasValue) ?? 0;

    private DateTime? DerniereRemontee =>
        posteList?
            .Where(p => p.LastSeen.HasValue)
            .Max(p => p.LastSeen);

    private string DerniereRemonteeTexte =>
        DerniereRemontee.HasValue
            ? DerniereRemontee.Value.ToString("dd/MM/yyyy HH:mm:ss")
            : "Aucune remontée détectée";
    private async Task DeletePoste(int posteId)
    {
        if (!IsAdmin)
        {
            Snackbar.Add("Seul l'administrateur peut supprimer.", Severity.Warning);
            return;
        }

        try
        {
            await PosteService.DeletePoste(posteId);
            posteList = await PosteService.GetAllPoste();
            Snackbar.Add("Poste supprimé avec succès.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    async Task OpenUpdateDialog(int posteId)
    {
        try
        {
            poste = await PosteService.GetPosteById(posteId);
            IsOpen = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    void CloseUpdateModal()
    {
        IsOpen = false;
        poste = new Poste();
    }

    private string GetNomSalle(int salleId)
    {
        var salle = salleList?.FirstOrDefault(s => s.Id == salleId);
        return salle?.Numero ?? "Non définie";
    }
}
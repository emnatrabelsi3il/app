<Page x:Class="PR3_WPF.Views.PostePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR3_WPF.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PostePage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto" />
            <!-- First row fills available space -->

        </Grid.RowDefinitions>
        <Grid>
            <TextBlock Text="Liste des Postes" HorizontalAlignment="Center"></TextBlock>
        </Grid>

        <Grid Margin="0,0,0,0" Grid.Row="1">
            <ListView x:Name="posteListView">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Numéro" DisplayMemberBinding="{Binding Numero}" Width="120"/>
                        <GridViewColumn Header="Adresse MAC" DisplayMemberBinding="{Binding MacAdress}" Width="180"/>
                        <GridViewColumn Header="Salle" DisplayMemberBinding="{Binding SalleNom}" Width="150"/>
                        <GridViewColumn Header="Établissement" DisplayMemberBinding="{Binding EtablissementNom}" Width="180"/>
                        
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </Grid>
</Page>

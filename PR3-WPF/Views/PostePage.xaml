<Page x:Class="PR3_WPF.Views.PostePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR3_WPF.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PostePage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto" />
            <!-- First row fills available space -->

        </Grid.RowDefinitions>
        <Grid>
            <TextBlock Text="Liste des Postes" HorizontalAlignment="Center"></TextBlock>
        </Grid>

        <Grid Margin="0,0,0,0" Grid.Row="1">
            <StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Actualiser le poste sélectionné"
                Width="220"
                Height="35"
                Margin="0,0,10,0"
                Click="RefreshSelectedPoste_Click"/>

                    <Button Content="Actualiser tous les postes"
                Width="200"
                Height="35"
                Click="RefreshAllPostes_Click"/>
                </StackPanel>

                <ListView x:Name="PostesListView"
              ScrollViewer.HorizontalScrollBarVisibility="Auto"
              ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Numéro" DisplayMemberBinding="{Binding Numero}" Width="120"/>
                            <GridViewColumn Header="Adresse MAC" DisplayMemberBinding="{Binding MacAdress}" Width="180"/>
                            <GridViewColumn Header="Salle" DisplayMemberBinding="{Binding SalleNom}" Width="150"/>
                            <GridViewColumn Header="Établissement" DisplayMemberBinding="{Binding EtablissementNom}" Width="180"/>

                            <GridViewColumn Header="Nom machine" DisplayMemberBinding="{Binding NomMachine}" Width="150"/>
                            <GridViewColumn Header="Adresse IP" DisplayMemberBinding="{Binding AdresseIP}" Width="130"/>
                            <GridViewColumn Header="Système" DisplayMemberBinding="{Binding OsVersion}" Width="220"/>

                            <GridViewColumn Header="RAM libre (MB)" DisplayMemberBinding="{Binding RamDisponibleMb, StringFormat={}{0:F0}}" Width="120"/>
                            <GridViewColumn Header="RAM totale (MB)" DisplayMemberBinding="{Binding RamTotaleMb, StringFormat={}{0:F0}}" Width="120"/>

                            <GridViewColumn Header="Disque libre (GB)" DisplayMemberBinding="{Binding DisqueLibreGb, StringFormat={}{0:F1}}" Width="130"/>
                            <GridViewColumn Header="Disque total (GB)" DisplayMemberBinding="{Binding DisqueTotalGb, StringFormat={}{0:F1}}" Width="130"/>

                            <GridViewColumn Header="Dernière remontée" DisplayMemberBinding="{Binding LastSeen, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Width="170"/>
                            <GridViewColumn Header="Connecté" DisplayMemberBinding="{Binding IsConnected}" Width="90"/>
                        </GridView>
                    </ListView.View>

                </ListView>

            </StackPanel>
        </Grid>
    </Grid>
</Page>

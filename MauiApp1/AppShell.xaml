<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiApp1.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MauiApp1"
    Shell.FlyoutBehavior="Disabled"
    Title="MauiApp1">

    <TabBar>
        <Tab Title="Home" Icon="accueil.png">
            <ShellContent
                Title="Home"
                ContentTemplate="{DataTemplate local:MainPage}"
                Route="MainPage" />
        </Tab>
        <Tab Title="Etablissement" Icon="etablissement.png">
            <ShellContent
                Title="Etablissement"
                ContentTemplate="{DataTemplate local:EtablissementPage}"
                Route="EtablissementPage" />
        </Tab>
        <Tab Title="Salle" Icon="salle.png">
            <ShellContent
                Title="Salle"
                ContentTemplate="{DataTemplate local:SallePage}"
                Route="SallePage" />
        </Tab>
        <Tab Title="Poste" Icon="poste.png">
            <ShellContent
                Title="Poste"
                ContentTemplate="{DataTemplate local:PostePage}"
                Route="PostePage" />
        </Tab>
        <Tab Title="Incident" Icon="incident.png">
        <ShellContent
                Title="Incident"
                ContentTemplate="{DataTemplate local:IncidentPage}"
                Route="IncidentPage" />
        </Tab>
        <Tab Title="Utilisateur" Icon="utilisateur.png">
            <ShellContent
                Title="Utilisateur"
                ContentTemplate="{DataTemplate local:UtilisateurPage}"
                Route="UtilisateurPage" />
        </Tab>
    </TabBar>


</Shell>

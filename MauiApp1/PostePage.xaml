<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.PostePage"
             Title="Postes">

    <ScrollView>
        <VerticalStackLayout Padding="15" Spacing="15">

            <Label Text="Liste des parcs informatiques"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Button Text="Actualiser tous les postes"
                    BackgroundColor="#2563EB"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="45"
                    Clicked="OnRefreshAllClicked" />

            <Button Text="Recharger la liste"
                    BackgroundColor="#0EA5E9"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="45"
                    Clicked="OnReloadClicked" />

            <CollectionView x:Name="PostesCollectionView"
                            ItemsSource="{Binding Postes}"
                            SelectionMode="None">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,8"
                               Padding="15"
                               CornerRadius="15"
                               BorderColor="#E5E7EB"
                               BackgroundColor="White"
                               HasShadow="True">

                            <VerticalStackLayout Spacing="7">

                                <Label Text="{Binding Numero}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="#111827" />

                                <Label Text="{Binding MacAdress, StringFormat='MAC : {0}'}"
                                       TextColor="#374151" />

                                <Label Text="{Binding SalleNom, StringFormat='Salle : {0}'}"
                                       TextColor="#374151" />

                                <Label Text="{Binding EtablissementNom, StringFormat='Établissement : {0}'}"
                                       TextColor="#374151" />

                                <Label Text="{Binding NomMachine, StringFormat='Nom machine : {0}'}"
                                       TextColor="#374151" />

                                <Label Text="{Binding AdresseIP, StringFormat='IP : {0}'}"
                                       TextColor="#374151" />

                                <Label Text="{Binding OsVersion, StringFormat='OS : {0}'}"
                                       TextColor="#374151" />

                                <Label Text="{Binding RamDisponibleMb, StringFormat='RAM disponible : {0:F0} MB'}"
                                       TextColor="#374151" />

                                <Label Text="{Binding RamTotaleMb, StringFormat='RAM totale : {0:F0} MB'}"
                                       TextColor="#374151" />

                                <Label Text="{Binding DisqueLibreGb, StringFormat='Disque libre : {0:F1} GB'}"
                                       TextColor="#374151" />

                                <Label Text="{Binding DisqueTotalGb, StringFormat='Disque total : {0:F1} GB'}"
                                       TextColor="#374151" />

                                <Label Text="{Binding LastSeen, StringFormat='Dernière remontée : {0:dd/MM/yyyy HH:mm:ss}'}"
                                       TextColor="#6B7280" />

                                <Button Text="Actualiser ce poste"
                                        BackgroundColor="#10B981"
                                        TextColor="White"
                                        CornerRadius="10"
                                        HeightRequest="42"
                                        CommandParameter="{Binding Id}"
                                        Clicked="OnRefreshOneClicked" />

                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
@page "/sallePage"



@using System.Text.Json
@using System.Text.Json.Serialization
@using Newtonsoft.Json
@using PR3_Blazor.Components.Models
@using PR3_Blazor.Components.Services
@using Blazored.Modal;
@using Blazored.Modal.Services
@using NetcodeHub.Packages.Components.Modal

@inject SalleService SalleService
@inject EtablissementService EtablissementService

@rendermode InteractiveServer


<div class="page-container">

    <div class="page-title">Gestion des salles</div>
    <div class="page-subtitle">Ajoutez, modifiez et consultez les salles</div>

    @if (!string.IsNullOrEmpty(erreurMessage))
    {
        <div class="alert-ui alert-error">@erreurMessage</div>
    }

    @if (!string.IsNullOrEmpty(succesMessage))
    {
        <div class="alert-ui alert-success">@succesMessage</div>
    }

    <div class="card-ui section-spacing">
        <button class="btn-ui btn-primary-ui" @onclick="OpenModal">Ajouter une salle</button>
    </div>

    @if (salleList != null)
    {
        <div class="table-wrapper">
            <table class="table-ui">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Numéro de la salle</th>
                        <th>Établissement</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var salle in salleList)
                    {
                        <tr>
                            <td>@salle.Id</td>
                            <td>@salle.Numero</td>
                            <td>@GetNomEtablissement(salle.EtablissementId)</td>
                            <td>
                                <button class="btn-ui btn-primary-ui" @onclick="() => OpenUpdateModal(salle.Id)">
                                    Editer
                                </button>
                                <button class="btn-ui btn-danger-ui" @onclick="() => DeleteSalle(salle.Id)">
                                    Supprimer
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p>Chargement des salles...</p>
    }

</div>

<Modal BootstrapClass="border-success"
       CustomStyle="width:400px"
       @bind-Open="IsOpen">
    <ContentContent>

        <form @onsubmit="AddSalle" @onsubmit:preventDefault>
            <div class="form-group">
                <label for="numero" class="form-label">Numéro de salle :</label>
                <input type="text"
                       id="numero"
                       class="form-control"
                       @bind="NumeroFiltre"
                       @bind:event="oninput"
                       placeholder="Ex : 12"
                       required />
            </div>

            <div class="form-group">
                <label for="etablissement" class="form-label">Établissement :</label>
                <select id="etablissement"
                        name="etablissement"
                        class="form-select"
                        @bind="salle.EtablissementId"
                        required>
                    <option value="0">Choisissez un établissement</option>
                    @if (etablissementList != null)
                    {
                        @foreach (var etablissement in etablissementList)
                        {
                            <option value="@etablissement.Id">@etablissement.Nom</option>
                        }
                    }
                </select>
            </div>

            <div class="d-flex justify-content-center align-content-center">
                <button type="submit" class="btn-ui btn-primary-ui" style="margin-right:8px;">
                    Enregistrer
                </button>
                <button type="button" class="btn-ui btn-secondary-ui" @onclick="CloseModal">
                    Annuler
                </button>
            </div>
        </form>

    </ContentContent>
</Modal>

<Modal BootstrapClass="border-success"
       CustomStyle="width:400px"
       @bind-Open="IsUpdateOpen">
    <ContentContent>

        <form @onsubmit="UpdateSalle" @onsubmit:preventDefault>
            <div class="form-group">
                <label for="numeroUpdate" class="form-label">Numéro de salle :</label>
                <input type="text"
                       id="numeroUpdate"
                       class="form-control"
                       @bind="NumeroFiltre"
                       @bind:event="oninput"
                       placeholder="Ex : 12"
                       required />
            </div>

            <div class="form-group">
                <label for="etablissementUpdate" class="form-label">Établissement :</label>
                <select id="etablissementUpdate"
                        name="etablissementUpdate"
                        class="form-select"
                        @bind="salle.EtablissementId"
                        required>
                    <option value="0">Choisissez un établissement</option>
                    @if (etablissementList != null)
                    {
                        @foreach (var etablissement in etablissementList)
                        {
                            <option value="@etablissement.Id">@etablissement.Nom</option>
                        }
                    }
                </select>
            </div>

            <div class="d-flex justify-content-center align-content-center">
                <button type="submit" class="btn-ui btn-primary-ui" style="margin-right:8px;">
                    Enregistrer
                </button>
                <button type="button" class="btn-ui btn-secondary-ui" @onclick="CloseUpdateModal">
                    Annuler
                </button>
            </div>
        </form>

    </ContentContent>
</Modal>

